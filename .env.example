# =============================================================================
# Zmienne poziomu Docker Compose (root). Skopiuj do `.env` obok docker-compose.*.yml
# Te wartości są podstawiane przez Compose w ${...} — NIE mylić z backend/.env.
# =============================================================================

# --- Porty hosta ---
BACKEND_PORT=3000
FRONTEND_PORT=8080
# POSTGRES_PORT=5432   # tylko dev compose (wystawia bazę na host)

# --- PostgreSQL (serwis `postgres` w compose) ---
POSTGRES_USER=opus
# WYMAGANE w produkcji — silne hasło. Prod compose odmówi startu bez tego.
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=opus

# --- DATABASE_URL ---
# Zostaw PUSTE, aby użyć wbudowanego serwisu `postgres` (host=postgres).
# Ustaw, aby wskazać ZEWNĘTRZNĄ bazę (RDS/Neon/Supabase) — wtedy serwisu postgres można nie startować.
#   DATABASE_URL=postgresql://user:pass@db.example.com:5432/opus?schema=public&sslmode=require
DATABASE_URL=

# --- MinIO (object storage; wymagane sekrety, brak domyślnych) ---
MINIO_ROOT_USER=opus-minio
MINIO_ROOT_PASSWORD=change-me-strong-minio-password

# --- CORS / UI ---
FRONTEND_ORIGIN=http://localhost:8080
