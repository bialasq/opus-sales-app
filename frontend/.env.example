# Vue CLI — zmienne muszą zaczynać się od VUE_APP_
# Skopiuj do .env.local (nie commituj sekretów)

# Pełny base URL API (axios). Przykład gdy backend na innym hoście/porcie:
# VUE_APP_API_URL=http://127.0.0.1:3000/api
#
# Puste = użyj względnego /api + proxy (wymaga VUE_APP_PROXY_TARGET poniżej)
VUE_APP_API_URL=http://localhost:3000/api

# Ten sam klucz co backend API_KEY (nagłówek x-api-key)
VUE_APP_API_KEY=replace-me-with-same-key-as-backend

# Cel proxy dla ścieżki /api (vue-cli dev). Domyślnie vue.config.js ustawia http://127.0.0.1:3000,
# jeśli zmienna jest pusta — nadpisz, gdy backend jest gdzie indziej:
# VUE_APP_PROXY_TARGET=http://127.0.0.1:3000
# W docker-compose ustawiane jest na http://backend:3000
VUE_APP_PROXY_TARGET=

# Opcjonalnie: URL odznaki „Powered by AI & Vibe Coding” w stopce (np. GitHub / LinkedIn)
# VUE_APP_VIBE_URL=https://github.com/twoj-profil
VUE_APP_VIBE_URL=
