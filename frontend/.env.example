# Vite — zmienne muszą zaczynać się od VITE_
# Skopiuj do .env.local (nie commituj sekretów)

# Pełny base URL API (axios). Przykład gdy backend na innym hoście/porcie:
# VITE_API_URL=http://127.0.0.1:3000/api
#
# Puste = użyj względnego /api + proxy (wymaga VITE_PROXY_TARGET poniżej)
VITE_API_URL=http://localhost:3000/api

# LEGACY (domyślnie wyłączone): nagłówek x-api-key używany tylko, gdy backend ma
# LEGACY_API_KEY_ENABLED=true i nie ma zalogowanego użytkownika (JWT).
# Normalna autoryzacja to logowanie w UI — tej zmiennej zwykle NIE ustawiaj.
# VITE_API_KEY=replace-me-with-same-key-as-backend

# Cel proxy dla ścieżki /api (vite dev). Domyślnie vite.config.ts ustawia http://127.0.0.1:3000,
# jeśli zmienna jest pusta — nadpisz, gdy backend jest gdzie indziej:
# VITE_PROXY_TARGET=http://127.0.0.1:3000
# W docker-compose ustawiane jest na http://backend:3000
VITE_PROXY_TARGET=

# Opcjonalnie: URL odznaki „Powered by AI & Vibe Coding” w stopce (np. GitHub / LinkedIn)
# VITE_VIBE_URL=https://github.com/twoj-profil
VITE_VIBE_URL=
