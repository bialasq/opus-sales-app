{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "tailwindcss": {
      "postcss-load-config": "5.1.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.typecheck.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,vue,css}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@sentry/vue": "^10.54.0",
    "axios": "^1.9.0",
    "chart.js": "^4.4.9",
    "echarts": "^5.6.0",
    "element-plus": "^2.10.1",
    "vue": "^3.2.13",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.0.3",
    "vuex": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "postcss": "^8.4.38",
    "prettier": "^3.9.1",
    "sass": "^1.32.7",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.3",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.0.29"
  }
}
