{
  "name": "business-analytics-backend",
  "version": "1.0.0",
  "description": "Backend dla aplikacji analizy biznesowej",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch .env --ext ts,json,env --exec tsx server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "generate-test-data": "node utils/generateTestData.js",
    "benchmark": "tsx scripts/benchmark.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:filePath": "vitest run tests/filePathResolver.test.ts",
    "test:budget": "vitest run tests/budgetManager.test.ts",
    "test:auth": "vitest run tests/auth.test.ts",
    "test:agent": "tsx scripts/agentUnitTests.ts",
    "gc:uploads": "tsx scripts/gcUploads.ts",
    "gc:logs": "tsx scripts/gcLogs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/s3-request-presigner": "^3.1055.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.54.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.20.0",
    "pdfkit": "^0.13.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.9.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.2.4"
  }
}
