# =============================================================================
# Backend — skopiuj do pliku .env i uzupełnij wartości
# =============================================================================

# --- Serwer HTTP ---
PORT=3000
NODE_ENV=development

# Adres UI (Vue) — używany na stronie głównej GET / (gdy wchodzisz w przeglądarce na :3000)
# FRONTEND_ORIGIN=http://localhost:8080

# --- Integracja AI (moduł /api/ai/insights) ---
# Dostawca: openai | anthropic (jeśli puste — wybór po dostępności kluczy, preferowany OpenAI)
AI_PROVIDER=anthropic

# OpenAI (np. gpt-4o) — główny model JSON dla sugestii promocji / domówień
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# Anthropic Claude 3.5 Sonnet — alternatywa (REST, bez dodatkowej paczki npm)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# Frontend (Vue CLI) — ustaw w frontend/.env.local LUB w docker-compose.yml
# Typy odpowiedzi API: backend/shared/api-types.ts (alias @shared w frontendzie)
# =============================================================================
#
# Pełny URL bazowy API używany przez axios (bez końcowego slasha).
# Przykład gdy backend jest dostępny z przeglądarki pod innym hostem/portem:
#   VUE_APP_API_URL=http://127.0.0.1:3000/api
#
# W Dockerze (domyślny docker-compose) zostaw PUSTE — wtedy używane jest
# względne /api i devServer proxy (VUE_APP_PROXY_TARGET -> backend).
#
# VUE_APP_API_URL=
#
# Cel proxy vue-cli-service (tylko dev), np. w Dockerze:
#   VUE_APP_PROXY_TARGET=http://backend:3000
