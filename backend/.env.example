# =============================================================================
# Backend — skopiuj do pliku .env i uzupełnij wartości
# =============================================================================

# --- Serwer HTTP ---
PORT=3000
NODE_ENV=development

# API key (min. 32 znaki) — wymagany dla wszystkich /api/* poza /api/health
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace-me-with-32-plus-char-random-string

# Adres UI (Vue) — CORS whitelist + link na GET /
FRONTEND_ORIGIN=http://localhost:8080

# --- Integracja AI (moduł /api/ai/insights) ---
# Dostawca: openai | anthropic | (puste = auto: OpenAI jeśli jest klucz, potem Anthropic)
# UWAGA: nie ustawiaj anthropic/openai bez uzupełnionego klucza — analiza ekspercka przejdzie w tryb regułowy.
AI_PROVIDER=

# OpenAI (np. gpt-4o) — analiza ekspercka, agenty, route planner
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o

# Anthropic Claude — alternatywa
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Agentic workflow (Analityk → Strateg) — opcjonalne nadpisanie modeli
# Analityk: tańszy model (Haiku)
AI_ANALYST_MODEL=claude-haiku-4-5-20251001
# Strateg: ReAct + tool calling
AI_STRATEGIST_MODEL=claude-sonnet-4-6
# Judge: audyt sugestii
AI_JUDGE_MODEL=claude-haiku-4-5-20251001

# Production-grade agent
AGENT_PROMPT_VERSION=agent_v2
AGENT_MAX_ITERATIONS=5
AGENT_SESSION_TOKEN_LIMIT=28000
AGENT_CACHE_TTL_MS=600000

# Limity kosztów i czasu LLM (ochrona budżetu API)
AI_BUDGET_USD_PER_DAY=10
AI_REQUEST_TIMEOUT_MS=60000

# Redis (opcjonalnie) — agent jobs + cache; puste = pamięć RAM (jedna replika)
REDIS_URL=

# Object storage (S3 / MinIO) — puste S3_BUCKET = lokalny katalog uploads/
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=uploads
UPLOAD_RETENTION_DAYS=90

# Observability (opcjonalnie)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=
LOG_RETENTION_DAYS=30

# =============================================================================
# Frontend (Vue CLI) — ustaw w frontend/.env.local LUB w docker-compose.yml
# Typy odpowiedzi API: backend/shared/api-types.ts (alias @shared w frontendzie)
# =============================================================================
#
# Pełny URL bazowy API używany przez axios (bez końcowego slasha).
# Przykład gdy backend jest dostępny z przeglądarki pod innym hostem/portem:
#   VUE_APP_API_URL=http://127.0.0.1:3000/api
#
# W Dockerze (domyślny docker-compose) zostaw PUSTE — wtedy używane jest
# względne /api i devServer proxy (VUE_APP_PROXY_TARGET -> backend).
#
# VUE_APP_API_URL=
#
# Cel proxy vue-cli-service (tylko dev), np. w Dockerze:
#   VUE_APP_PROXY_TARGET=http://backend:3000

# --- Konta / baza ---
DATABASE_URL=postgresql://opus:opus@localhost:5432/opus?schema=public

# Wygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-32-plus-char-random-string
LEGACY_API_KEY_ENABLED=true
